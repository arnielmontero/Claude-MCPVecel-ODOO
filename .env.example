# Odoo 17 integration
# Real values belong in Vercel Environment Variables, never committed here.
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_PASSWORD=

# Shared secret the MCP client (Claude Pro) must send as a Bearer token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
